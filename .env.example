# Elexon API
ELEXON_BASE_URL=https://data.elexon.co.uk/bmrs/api/v1
ELEXON_TIMEOUT_CONNECT=10
ELEXON_TIMEOUT_READ=60
ELEXON_MAX_RETRIES=3
ELEXON_RETRY_BACKOFF=2.0

# Analysis scope
ANALYSIS_START_DATE=2026-01-01
ANALYSIS_END_DATE=2026-01-31

# Procurement decision cutoff (PROVISIONAL -- not an official UK electricity market rule)
CUTOFF_HOUR=10
CUTOFF_MINUTE=0
CUTOFF_TIMEZONE=Europe/London
CUTOFF_DAY_OFFSET=1

# Backend CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Data paths
DATA_DIR=./data

# Cache TTL in seconds
CACHE_TTL_SECONDS=300

# Demo mode: true = serve synthetic fixtures without a live Elexon API call
DEMO_MODE=false

# Frontend environment
# Local development:
VITE_API_BASE_URL=http://localhost:8000
# Production Vercel environment variable:
# VITE_API_BASE_URL=https://gridbricks-wind-portal.onrender.com
